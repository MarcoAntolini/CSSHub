{
	"manifest_version": 3,
	"name": "CssHub",
	"author": "CssHub",
	"version": "1.2.0",
	"description": "Sync CSSBattle submissions to GitHub",
	"icons": {
		"16": "icons/icon_16.png",
		"32": "icons/icon_32.png",
		"48": "icons/icon_48.png",
		"128": "icons/icon_128.png"
	},
	"action": {
		"default_title": "CssHub",
		"default_popup": "popup.html"
	},
	"options_ui": {
		"page": "settings.html",
		"open_in_tab": true
	},
	"permissions": ["storage", "activeTab", "tabs", "identity", "scripting", "notifications"],
	"host_permissions": [
		"https://api.github.com/*",
		"https://github.com/*",
		"https://cssbattle.dev/*",
		"https://www.cssbattle.dev/*",
		"https://ik.imagekit.io/*",
		"https://firebasestorage.googleapis.com/*",
		"<all_urls>"
	],
	"content_scripts": [
		{
			"matches": [
				"https://cssbattle.dev/play/*",
				"https://www.cssbattle.dev/play/*"
			],
			"js": ["shortcutBridge.js"],
			"run_at": "document_start",
			"world": "MAIN"
		},
		{
			"matches": [
				"https://cssbattle.dev/play/*",
				"https://www.cssbattle.dev/play/*"
			],
			"js": ["contentScript.js"],
			"run_at": "document_start"
		}
	],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	}
}
