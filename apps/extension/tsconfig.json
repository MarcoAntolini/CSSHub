{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		},
		"strict": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"forceConsistentCasingInFileNames": true,
		"jsx": "react-jsx",
		"types": ["chrome"]
	},
	"include": ["src", "tests", "vite.config.ts", "vitest.config.ts"],
	"references": [{ "path": "../../packages/shared" }]
}
