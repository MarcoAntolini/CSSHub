{
	"name": "@csshub/extension",
	"version": "1.4.0",
	"description": "CssHub Chrome Extension",
	"author": "CssHub",
	"license": "MIT",
	"private": true,
	"keywords": [],
	"type": "module",
	"scripts": {
		"dev": "vite build --watch --mode development",
		"dev:all": "npm run dev",
		"build": "npm run build:prod",
		"build:all": "npm run build",
		"build:prod": "vite build --mode production",
		"build:dev": "vite build --mode development",
		"build:staging": "vite build --mode staging",
		"build:preview": "vite build --mode preview",
		"typecheck": "tsc --build",
		"typecheck:all": "npm run typecheck",
		"test": "vitest run",
		"test:e2e": "npm run build:dev && playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@types/chrome": "^0.1.24",
		"@types/react": "^19.1.5",
		"@types/react-dom": "^19.1.5",
		"@vitejs/plugin-react": "^4.5.2",
		"esbuild": "^0.25.12",
		"jsdom": "^26.1.0",
		"typescript": "^5.8.3",
		"vite": "^6.3.5",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@csshub/shared": "*",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"sonner": "^2.0.7",
		"zod": "^3.24.4"
	}
}
